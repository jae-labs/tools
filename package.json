{
  "name": "tools",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build && npx prisma dev",
    "build": "vite build && node build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "deploy": "npm run check && npx prisma deploy",
    "deploy:all": "node scripts/deploy-all.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/composer": "^0.39.0",
    "@prisma/composer-prisma-cloud": "^0.39.0",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide": "^1.80.0",
    "oui-data": "^2.1.68",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.10",
    "@types/three": "^0.183.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "^8.0.0-rc.34",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
