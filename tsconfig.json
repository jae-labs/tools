{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "vite/client"]
  },
  "include": ["*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
